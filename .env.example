# Contrato de configuración del proyecto (ver README.md y CLAUDE.md).
# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Ningún secreto real va en este archivo ni en el repositorio.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=b2b_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=b2b_lead_generation
# Puertos no estándar (5433/6380) a propósito: evitan chocar con un Postgres/
# Redis nativo que ya pudiera estar corriendo en el 5432/6379 del host. Cambia
# ambos si en tu máquina también están libres los estándar, o si ya usas
# 5433/6380 para otra cosa.
POSTGRES_PORT=5433
# Password del rol de aplicación (app_role), sin BYPASSRLS — ver infra/postgres-init.
APP_ROLE_PASSWORD=change-me-app-role-password

# --- Redis (docker-compose) ---
REDIS_PORT=6380

# --- apps/api: conexión de runtime (rol app_role, respeta RLS) ---
DATABASE_URL=postgresql+asyncpg://app_role:change-me-app-role-password@localhost:5433/b2b_lead_generation

# --- apps/api: conexión de migraciones (rol dueño del esquema, usada solo por Alembic) ---
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://b2b_owner:change-me-owner-password@localhost:5433/b2b_lead_generation

# --- apps/api: cola/scheduler (arq) ---
REDIS_URL=redis://localhost:6380/0

# --- apps/api: autenticación JWT (DECISIÓN-4) ---
JWT_SECRET_KEY=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- apps/api: Job Generator, multi-proveedor LLM vía LangChain (DECISIÓN-8) ---
# Solo se necesita la API key del proveedor activo en ai_provider_config.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- apps/channels-service: Telegram ---
TELEGRAM_BOT_TOKEN=

# --- apps/api: pagos (DECISIÓN-13, adapter sin proveedor real todavía) ---
PAYMENT_PROVIDER=mock
